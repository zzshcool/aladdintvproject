<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <Button
        android:id="@+id/btnTouchMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/touch_menu_glyph"
        android:contentDescription="@string/touch_menu"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/layoutTouchControls"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:elevation="8dp"
        android:background="#CC101010"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnTouchMenu">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnTouchChannels" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:text="@string/touch_channels" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnTouchSources" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:text="@string/touch_sources" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnTouchSettings" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:text="@string/touch_settings" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnTouchFill" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:text="@string/touch_fill" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnTouchExit" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:text="@string/touch_exit" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnTouchWeb" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:text="@string/touch_web" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 1. 全螢幕 Media3 播放器 (ExoPlayer 解碼 HLS/MP4/TS) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- 2. 全螢幕官方 YouTube IFrame 內嵌播放器 (WebView) -->
    <com.aladdin.tv.ui.view.YouTubeIframePlayerView
        android:id="@+id/youtubePlayerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. YouTube 內嵌播放錯誤提示與切台引導浮層 -->
    <ScrollView
        android:id="@+id/layoutYoutubeError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:paddingHorizontal="28dp"
        android:paddingVertical="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constrainedHeight="true"
        android:layout_marginVertical="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">

        <TextView
            android:id="@+id/tvYoutubeErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/youtube_error_embedded_disabled"
            android:textColor="@color/tv_error"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutYoutubeErrorActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnYoutubeRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/btn_retry"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnYoutubeSelectSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/select_other_source"
                android:textColor="?attr/tvAccent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnYoutubeWebWatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/watch_official_page"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnYoutubeNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/return_channel_list"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 4. 緩衝與載入中浮層 -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/tvAccent" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/buffering"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. 錯誤與重試提示浮層 -->
    <ScrollView
        android:id="@+id/layoutError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constrainedHeight="true"
        android:layout_marginVertical="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">

        <TextView
            android:id="@+id/tvErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playback_error"
            android:textColor="@color/tv_error"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorRetryCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutNativeErrorActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnErrorRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/btn_retry"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnErrorSelectSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/select_other_source"
                android:textColor="?attr/tvAccent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnErrorOpenDrawer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/return_channel_list"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 6. 底部 OSD 浮層 (換台、點擊或遙控器觸發時顯示) -->
    <LinearLayout
        android:id="@+id/layoutOsd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_osd_gradient"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 台號 -->
            <TextView
                android:id="@+id/tvOsdChannelNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/tvAccent"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="CH 53" />

            <!-- 頻道名稱 -->
            <TextView
                android:id="@+id/tvOsdChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="民視新聞台" />

            <!-- 當前系統時間 -->
            <TextView
                android:id="@+id/tvOsdTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="20:00" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <!-- 分組標籤 -->
            <TextView
                android:id="@+id/tvOsdChannelGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_channel_focus"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                tools:text="新聞" />

            <!-- 解析度 / 來源標籤 -->
            <TextView
                android:id="@+id/tvOsdResolution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_overlay_panel"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/live_label"
                android:textColor="?attr/tvAccent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>
    </LinearLayout>

    <!-- 7. 數字鍵跳台浮層 -->
    <LinearLayout
        android:id="@+id/layoutNumberJump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="36dp"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/number_jump_label"
            android:textColor="@color/tv_text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvNumberInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:textColor="?attr/tvAccent"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="53" />
    </LinearLayout>

    <!-- 8. 左側選台抽屜 -->
    <LinearLayout
        android:id="@+id/layoutDrawer"
        android:layout_width="350dp"
        android:layout_height="0dp"
        android:background="@color/tv_drawer_bg"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="?attr/tvAccent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerChannelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                tools:text="共 80 台" />

            <TextView
                android:id="@+id/btnOpenSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="@string/settings"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnFavoriteList" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/favorite_channels" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnRecentChannels" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/recent_channels" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- 9. 設定面板浮層 (防誤觸：按鍵完全留在面板內) -->
    <ViewStub
        android:id="@+id/settingsStub"
        android:inflatedId="@id/layoutSettings"
        android:layout="@layout/panel_settings"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constrainedHeight="true" />

    <!-- 10. 官方網頁互動模式提示橫幅 (頂部浮動) -->
    <LinearLayout
        android:id="@+id/layoutWebInteractionBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/web_interaction_hint"
            android:textColor="?attr/tvAccent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 11. 同頻道手動選線路面板 (遙控器主導) -->
    <LinearLayout
        android:id="@+id/layoutSourceSelection"
        android:layout_width="420dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_overlay_panel"
        android:elevation="30dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSourceSelectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="民視新聞台 - 線路選擇" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/source_selection_hint"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStreamSources"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_source" />

        <TextView
            android:id="@+id/btnCloseSourceSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_channel_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/close_source_panel"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
