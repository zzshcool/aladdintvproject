<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <!-- 1. 全螢幕 Media3 播放器 (ExoPlayer 解碼 HLS/MP4/TS) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- 2. 全螢幕官方 YouTube IFrame 內嵌播放器 (WebView) -->
    <com.aladdin.tv.ui.view.YouTubeIframePlayerView
        android:id="@+id/youtubePlayerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. YouTube 內嵌播放錯誤提示與切台引導浮層 -->
    <LinearLayout
        android:id="@+id/layoutYoutubeError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvYoutubeErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/youtube_error_embedded_disabled"
            android:textColor="@color/tv_error"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnYoutubeRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/btn_retry"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnYoutubeSelectSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="選擇其他線路"
                android:textColor="@color/tv_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnYoutubeWebWatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="以官方網頁觀看"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnYoutubeNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="返回頻道列表"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. 緩衝與載入中浮層 -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/tv_accent" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/buffering"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. 錯誤與重試提示浮層 -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playback_error"
            android:textColor="@color/tv_error"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorRetryCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnErrorRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/btn_retry"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnErrorSelectSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="選擇其他線路"
                android:textColor="@color/tv_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnErrorOpenDrawer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="返回頻道列表"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. 底部 OSD 浮層 (換台、點擊或遙控器觸發時顯示) -->
    <LinearLayout
        android:id="@+id/layoutOsd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_osd_gradient"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 台號 -->
            <TextView
                android:id="@+id/tvOsdChannelNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_accent"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="CH 53" />

            <!-- 頻道名稱 -->
            <TextView
                android:id="@+id/tvOsdChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="民視新聞台" />

            <!-- 分組標籤 -->
            <TextView
                android:id="@+id/tvOsdChannelGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_channel_focus"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                tools:text="新聞" />

            <!-- 解析度 / 來源標籤 -->
            <TextView
                android:id="@+id/tvOsdResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_overlay_panel"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="LIVE"
                android:textColor="@color/tv_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 當前系統時間 -->
            <TextView
                android:id="@+id/tvOsdTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="20:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- 7. 數字鍵跳台浮層 -->
    <LinearLayout
        android:id="@+id/layoutNumberJump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="36dp"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跳台："
            android:textColor="@color/tv_text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvNumberInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:textColor="@color/tv_accent"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="53" />
    </LinearLayout>

    <!-- 8. 左側選台抽屜 -->
    <LinearLayout
        android:id="@+id/layoutDrawer"
        android:layout_width="350dp"
        android:layout_height="0dp"
        android:background="@color/tv_drawer_bg"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/tv_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerChannelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                tools:text="共 80 台" />

            <TextView
                android:id="@+id/btnOpenSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="@string/settings"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- 9. 設定面板浮層 (防誤觸：按鍵完全留在面板內) -->
    <ScrollView
        android:id="@+id/layoutSettings"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_title"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_channel_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/close_settings"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 1. 外觀主題區 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/theme_setting"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnThemeSystem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/theme_system"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnThemeDark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/theme_dark"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnThemeLight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/theme_light"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 2. 畫質上限偏好區 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/quality_setting"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnQualityAuto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/quality_auto"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnQuality1080p"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/quality_1080p"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnQuality4k"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/quality_4k"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/quality_note"
                android:textColor="@color/tv_text_secondary"
                android:textSize="11sp" />

            <!-- 3. 頻道來源資訊區 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/source_status_title"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_channel_focus"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvSourceStatusDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="主要與備用來源更新成功" />

                <TextView
                    android:id="@+id/tvSourceLastUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp"
                    tools:text="最後更新：2026/10/11 22:30" />

                <TextView
                    android:id="@+id/tvSourceChannelCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp"
                    tools:text="有效頻道：82 台" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnRefreshChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="@string/refresh_channels"
                android:textColor="@color/tv_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 4. 播放即時診斷資訊區 (敏感參數已脫敏) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="即時播放診斷"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_channel_focus"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvDiagChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="頻道：CH 51 東森新聞台" />

                <TextView
                    android:id="@+id/tvDiagSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp"
                    tools:text="線路：HiNet CDN (1/2)" />

                <TextView
                    android:id="@+id/tvDiagMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp"
                    tools:text="模式：Media3 原生硬解 (支援畫質限制)" />

                <TextView
                    android:id="@+id/tvDiagQualityStrategy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp"
                    tools:text="4K策略：自動" />

                <TextView
                    android:id="@+id/tvDiagResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp"
                    tools:text="本輪嘗試：成功" />
            </LinearLayout>

            <!-- 5. 備援與資料管理 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="備援策略與資料管理"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnToggleAutoFallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="自動備援切換：已關閉 (手動主導)"
                android:textColor="@color/tv_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearWebData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_channel_focus"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="清除網頁快取與登入資料"
                android:textColor="@color/tv_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 10. 官方網頁互動模式提示橫幅 (頂部浮動) -->
    <LinearLayout
        android:id="@+id/layoutWebInteractionBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="網頁操作模式中 · 按 [MENU] 或 [返回] 隨時返回電視控制"
            android:textColor="@color/tv_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 11. 同頻道手動選線路面板 (遙控器主導) -->
    <LinearLayout
        android:id="@+id/layoutSourceSelection"
        android:layout_width="420dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_overlay_panel"
        android:elevation="30dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSourceSelectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="民視新聞台 - 線路選擇" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="移動焦點預覽，按 [OK] 切換線路，按 [返回] 取消"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStreamSources"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_source" />

        <TextView
            android:id="@+id/btnCloseSourceSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_channel_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="關閉面板 (保留原線路)"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
