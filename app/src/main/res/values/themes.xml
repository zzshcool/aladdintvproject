<resources>
    <attr name="tvAccent" format="color" />
    <attr name="tvFocusStroke" format="color" />
    <attr name="tvTextHighlight" format="color" />
    <!-- 基礎電視主題：全螢幕、無ActionBar、支援深色/淺色/跟隨系統 -->
    <style name="Theme.AladdinTV" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="tvAccent">@color/tv_accent</item>
        <item name="tvFocusStroke">@color/tv_focus_stroke</item>
        <item name="tvTextHighlight">@color/tv_text_highlight</item>
        <item name="colorAccent">?attr/tvAccent</item>
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:keepScreenOn">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="AladdinAccentGold">
        <item name="tvAccent">@color/tv_accent</item>
        <item name="tvFocusStroke">@color/tv_accent</item>
        <item name="tvTextHighlight">@color/tv_accent</item>
        <item name="colorAccent">@color/tv_accent</item>
    </style>
    <style name="AladdinAccentBlue">
        <item name="tvAccent">@color/accent_blue</item>
        <item name="tvFocusStroke">@color/accent_blue</item>
        <item name="tvTextHighlight">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
    </style>
    <style name="AladdinAccentGreen">
        <item name="tvAccent">@color/accent_green</item>
        <item name="tvFocusStroke">@color/accent_green</item>
        <item name="tvTextHighlight">@color/accent_green</item>
        <item name="colorAccent">@color/accent_green</item>
    </style>
    <style name="AladdinAccentPurple">
        <item name="tvAccent">@color/accent_purple</item>
        <item name="tvFocusStroke">@color/accent_purple</item>
        <item name="tvTextHighlight">@color/accent_purple</item>
        <item name="colorAccent">@color/accent_purple</item>
    </style>
</resources>
