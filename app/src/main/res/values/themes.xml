<resources>
    <!-- 基礎電視主題：全螢幕、無ActionBar、支援深色/淺色/跟隨系統 -->
    <style name="Theme.AladdinTV" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:keepScreenOn">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
    </style>
</resources>
