<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 同時處於焦點與選中播放狀態 -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2.5dp" android:color="@color/tv_focus_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 獲取遙控器焦點狀態 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2dp" android:color="@color/tv_focus_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 當前播放選中狀態 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="1dp" android:color="@color/tv_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 預設常態 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_bg" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
