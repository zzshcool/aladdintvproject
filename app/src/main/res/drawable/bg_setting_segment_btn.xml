<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 同時處於焦點與選中狀態 (遙控器游標停在當前生效的選項上) -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2.5dp" android:color="?attr/tvFocusStroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 獲取遙控器焦點狀態 (未選中但獲取焦點) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2dp" android:color="?attr/tvFocusStroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 當前生效的選中狀態 (未獲焦點時，清晰展示金色/強調色高亮邊框) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2dp" android:color="?attr/tvAccent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 預設常態 (未選中、無焦點) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_bg" />
            <stroke android:width="1dp" android:color="@color/tv_badge_bg" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
