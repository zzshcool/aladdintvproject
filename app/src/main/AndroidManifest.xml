<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 網路與喚醒權限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 支援電視盒 (無觸控螢幕、實體遙控器操控) -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- API 21–22 already permit HTTP; API 23+ uses this flag for existing HTTP TV sources. -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AladdinTV"
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">

        <!-- TV playback intentionally uses either landscape rotation on phones and TV boxes. -->
        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.AladdinTV"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 手機端桌面啟動入口 -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV / 電視盒桌面專用入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
